# PostgreSQL
DATABASE_URL=postgresql://fitconnect_user:CHANGE_ME@postgres:5432/fitconnect_db?sslmode=disable
# Optional raw password override; keep blank when DATABASE_URL already has the password.
DB_PASSWORD=

# Public URL (include a subdirectory if deployed in one; no trailing slash)
APP_BASE_URL=https://fitconnect.example.com
APP_ENV=production

# Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# LINE
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS=
LINE_CHANNEL_TOKEN=
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
